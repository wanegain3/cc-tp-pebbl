{
  "disableAllHooks": true,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Read(**/*)",
      "mcp__playwright__*"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "cat > post-log.json"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(*.html)",
            "command": "echo '{\"systemMessage\":\"Tu as modifié une page HTML, pense à lancer les audits accessibilité/responsive.\"}'"
          },
          {
            "type": "command",
            "if": "Write(*.html)",
            "command": "echo '{\"systemMessage\":\"Tu as modifié une page HTML, pense à lancer les audits accessibilité/responsive.\"}'"
          }
        ]
      }
    ],
    "UserPromptSubmit": []
  },
  "enabledPlugins": {
    "php-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": true
  },
  "language": "français"
}
