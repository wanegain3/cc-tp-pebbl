Options -Indexes
php_flag display_errors off
php_flag log_errors on

# Filet de sécurité : bloquer tout accès HTTP direct aux fichiers SQLite
<FilesMatch "\.(sqlite|sqlite-journal|sqlite-wal|sqlite-shm|db)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
